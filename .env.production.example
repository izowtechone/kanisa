APP_NAME="KKKT CMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
APP_TIMEZONE=Africa/Dar_es_Salaam

APP_LOCALE=sw
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Shared hosting has no permanent worker: see docs/SMS_AND_OTP_DEPLOYMENT.md and docs/PWA_AND_DEPLOYMENT_GUIDE.md.
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180
CACHE_STORE=database

# Login OTP limits (codes are 6 digits; SMS delivery uses the otp queue).
LOGIN_OTP_EXPIRATION_MINUTES=5
LOGIN_OTP_MAX_ATTEMPTS=5
LOGIN_OTP_RESEND_COOLDOWN_SECONDS=60
LOGIN_OTP_SEND_LIMIT_PER_HOUR=5
LOGIN_OTP_IP_SEND_LIMIT_PER_HOUR=20
LOGIN_ACCOUNT_FAILURES_PER_HOUR=10
LOGIN_IP_FAILURES_PER_HOUR=50
LOGIN_PROGRESSIVE_LOCKOUT_SECONDS=30
LOGIN_PROGRESSIVE_LOCKOUT_MAX_SECONDS=900
LOGIN_SECURITY_EVENTS_RETENTION_DAYS=180

# Mail is optional. SMS provider credentials are entered in Settings and stored encrypted; never put them here.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@your-domain.example"
MAIL_FROM_NAME="${APP_NAME}"
